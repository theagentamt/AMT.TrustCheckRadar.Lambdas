{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transportVersion",
    "checkId",
    "operationProof",
    "state",
    "access",
    "accounting",
    "outcome",
    "errorCode",
    "retryAfterSeconds",
    "expiresAt",
    "usage",
    "resultAvailability"
  ],
  "properties": {
    "transportVersion": {
      "const": "1.0.0-recovery-candidate.1"
    },
    "checkId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "operationProof": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^v1_[A-Za-z0-9]{1,8}_[0-9a-f]{8}_[0-9a-f]{16}_[0-9a-f]{24}$"
    },
    "state": {
      "enum": [
        "prepared",
        "pending",
        "settled",
        "unknown",
        "rejected"
      ]
    },
    "access": {
      "$ref": "#/$defs/Access"
    },
    "accounting": {
      "$ref": "#/$defs/Accounting"
    },
    "outcome": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/RecoveryOutcome"
        }
      ]
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "AUTHENTICATION_REQUIRED",
        "ACCOUNT_UNAVAILABLE",
        "ACTIVE_DEVICE_REQUIRED",
        "EXTERNAL_ACCESS_UNAVAILABLE",
        "ALLOWANCE_EXHAUSTED",
        "INPUT_REJECTED",
        "CHECK_ID_CONFLICT",
        "OPERATION_EXPIRED",
        "RATE_LIMITED",
        "OPERATION_PENDING",
        "SERVICE_UNAVAILABLE",
        "CONTRACT_UNSUPPORTED",
        "PRIVACY_REVIEW_REQUIRED",
        "SERVICE_NOT_ENABLED"
      ]
    },
    "retryAfterSeconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "expiresAt": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "usage": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/RecoveryUsage"
        }
      ]
    },
    "resultAvailability": {
      "enum": [
        "none",
        "pending",
        "available",
        "not_retained"
      ]
    }
  },
  "$defs": {
    "Access": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "basis",
        "externalChecksAllowed",
        "builtInChecksAllowed",
        "reconciliationAllowed",
        "remainingChecks",
        "resetsAt",
        "unlimited",
        "observedAt"
      ],
      "properties": {
        "state": {
          "enum": [
            "allowed",
            "sign_in_required",
            "device_action_required",
            "subscription_required",
            "allowance_exhausted",
            "temporarily_unavailable"
          ]
        },
        "basis": {
          "enum": [
            "paid",
            "trial",
            "complimentary",
            "none",
            "unknown"
          ]
        },
        "externalChecksAllowed": {
          "type": "boolean"
        },
        "builtInChecksAllowed": {
          "type": "boolean"
        },
        "reconciliationAllowed": {
          "type": "boolean"
        },
        "remainingChecks": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "resetsAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "unlimited": {
          "type": "boolean"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "allowed"
              }
            }
          },
          "then": {
            "properties": {
              "externalChecksAllowed": {
                "const": true
              },
              "basis": {
                "enum": [
                  "paid",
                  "trial",
                  "complimentary"
                ]
              },
              "builtInChecksAllowed": {
                "const": true
              },
              "reconciliationAllowed": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "not": {
                  "const": "allowed"
                }
              }
            }
          },
          "then": {
            "properties": {
              "externalChecksAllowed": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "sign_in_required"
              }
            }
          },
          "then": {
            "properties": {
              "builtInChecksAllowed": {
                "const": false
              },
              "reconciliationAllowed": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "allowance_exhausted"
              }
            }
          },
          "then": {
            "properties": {
              "remainingChecks": {
                "const": 0
              },
              "unlimited": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "unlimited": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "basis": {
                "const": "complimentary"
              },
              "remainingChecks": {
                "type": "null"
              },
              "resetsAt": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "allowed"
              },
              "basis": {
                "enum": [
                  "paid",
                  "trial"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "remainingChecks": {
                "type": "integer",
                "minimum": 1
              },
              "unlimited": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "allowed"
              },
              "basis": {
                "const": "complimentary"
              }
            }
          },
          "then": {
            "properties": {
              "unlimited": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "Accounting": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "chargedChecks",
        "receiptId",
        "requiresReconciliation"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_started",
            "pending",
            "charged",
            "not_charged",
            "unknown"
          ]
        },
        "chargedChecks": {
          "enum": [
            null,
            0,
            1
          ]
        },
        "receiptId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "requiresReconciliation": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_started"
              }
            }
          },
          "then": {
            "properties": {
              "chargedChecks": {
                "const": 0
              },
              "receiptId": {
                "type": "null"
              },
              "requiresReconciliation": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "charged"
              }
            }
          },
          "then": {
            "properties": {
              "chargedChecks": {
                "const": 1
              },
              "receiptId": {
                "type": "string"
              },
              "requiresReconciliation": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_charged"
              }
            }
          },
          "then": {
            "properties": {
              "chargedChecks": {
                "const": 0
              },
              "receiptId": {
                "type": "string"
              },
              "requiresReconciliation": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "pending",
                  "unknown"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "chargedChecks": {
                "type": "null"
              },
              "requiresReconciliation": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "RecoveryOutcome": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "checkId",
        "policyVersion",
        "playbookVersion",
        "processingOutcome",
        "reasonCode",
        "exposureIds",
        "actionIds",
        "applyRequiresConfirmation"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "kind": {
          "const": "recovery_clarification"
        },
        "checkId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "policyVersion": {
          "const": "recovery-clarification-2026-09-21-v1"
        },
        "playbookVersion": {
          "const": "recovery-playbook-1.0"
        },
        "processingOutcome": {
          "enum": [
            "complete",
            "inconclusive",
            "partial",
            "failed",
            "blocked",
            "invalid_input",
            "unsupported",
            "unavailable"
          ]
        },
        "reasonCode": {
          "enum": [
            null,
            "INSUFFICIENT_EVIDENCE",
            "INCOMPLETE_RESPONSE",
            "PROVIDER_UNAVAILABLE",
            "HOSTILE_INPUT_STOP",
            "INPUT_REJECTED",
            "UNSUPPORTED_CONTENT",
            "PROVIDER_RESPONSE_INVALID",
            "BUDGET_LIMIT",
            "SERVICE_NOT_ENABLED"
          ]
        },
        "exposureIds": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "clicked_link",
              "credentials_or_mfa",
              "financial_or_identity",
              "sent_payment",
              "software_or_remote_access"
            ]
          }
        },
        "actionIds": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "payment_contact",
              "account_secure",
              "financial_contact",
              "link_stop",
              "device_secure",
              "payment_receipts",
              "identity_steps",
              "link_verify",
              "device_support"
            ]
          }
        },
        "applyRequiresConfirmation": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "processingOutcome": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "reasonCode": {
                "const": null
              },
              "exposureIds": {
                "minItems": 1
              },
              "actionIds": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "exposureIds": {
                "maxItems": 0
              },
              "actionIds": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "processingOutcome": {
                "const": "inconclusive"
              }
            }
          },
          "then": {
            "properties": {
              "reasonCode": {
                "enum": [
                  "INSUFFICIENT_EVIDENCE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "processingOutcome": {
                "const": "partial"
              }
            }
          },
          "then": {
            "properties": {
              "reasonCode": {
                "enum": [
                  "INCOMPLETE_RESPONSE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "processingOutcome": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "reasonCode": {
                "enum": [
                  "PROVIDER_UNAVAILABLE"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "processingOutcome": {
                "const": "blocked"
              }
            }
          },
          "then": {
            "properties": {
              "reasonCode": {
                "enum": [
                  "HOSTILE_INPUT_STOP"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "processingOutcome": {
                "const": "invalid_input"
              }
            }
          },
          "then": {
            "properties": {
              "reasonCode": {
                "enum": [
                  "INPUT_REJECTED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "processingOutcome": {
                "const": "unsupported"
              }
            }
          },
          "then": {
            "properties": {
              "reasonCode": {
                "enum": [
                  "UNSUPPORTED_CONTENT"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "processingOutcome": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "reasonCode": {
                "enum": [
                  "PROVIDER_UNAVAILABLE",
                  "PROVIDER_RESPONSE_INVALID",
                  "BUDGET_LIMIT",
                  "SERVICE_NOT_ENABLED"
                ]
              }
            }
          }
        }
      ]
    },
    "RecoveryUsage": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "checkId",
        "policyVersion",
        "playbookVersion",
        "processingOutcome",
        "kind",
        "contentDisposition"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "checkId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "policyVersion": {
          "const": "recovery-clarification-2026-09-21-v1"
        },
        "playbookVersion": {
          "const": "recovery-playbook-1.0"
        },
        "processingOutcome": {
          "enum": [
            "complete",
            "inconclusive",
            "partial",
            "failed",
            "blocked",
            "invalid_input",
            "unsupported",
            "unavailable"
          ]
        },
        "kind": {
          "const": "recovery_usage"
        },
        "contentDisposition": {
          "const": "not_retained"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "prepared"
          }
        }
      },
      "then": {
        "properties": {
          "accounting": {
            "properties": {
              "state": {
                "const": "not_started"
              }
            }
          },
          "outcome": {
            "type": "null"
          },
          "checkId": {
            "type": "string"
          },
          "operationProof": {
            "type": "string"
          },
          "expiresAt": {
            "type": "integer"
          },
          "errorCode": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "pending"
          }
        }
      },
      "then": {
        "properties": {
          "accounting": {
            "properties": {
              "state": {
                "const": "pending"
              }
            }
          },
          "outcome": {
            "type": "null"
          },
          "checkId": {
            "type": "string"
          },
          "operationProof": {
            "type": "string"
          },
          "expiresAt": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "accounting": {
            "properties": {
              "state": {
                "const": "unknown"
              }
            }
          },
          "outcome": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "settled"
          }
        }
      },
      "then": {
        "properties": {
          "checkId": {
            "type": "string"
          },
          "operationProof": {
            "type": "string"
          },
          "expiresAt": {
            "type": "integer"
          },
          "accounting": {
            "properties": {
              "state": {
                "enum": [
                  "charged",
                  "not_charged"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "rejected"
          }
        }
      },
      "then": {
        "properties": {
          "checkId": {
            "type": "string"
          },
          "operationProof": {
            "type": "string"
          },
          "errorCode": {
            "const": "OPERATION_EXPIRED"
          },
          "outcome": {
            "type": "null"
          },
          "expiresAt": {
            "type": "integer"
          },
          "accounting": {
            "properties": {
              "state": {
                "const": "not_started"
              },
              "chargedChecks": {
                "const": 0
              },
              "receiptId": {
                "type": "null"
              },
              "requiresReconciliation": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "settled"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "accounting": {
            "properties": {
              "chargedChecks": {
                "const": 1
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "settled"
          },
          "outcome": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "properties": {
                  "processingOutcome": {
                    "const": "complete"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "settled"
          }
        }
      },
      "then": {
        "properties": {
          "usage": {
            "$ref": "#/$defs/RecoveryUsage"
          }
        }
      },
      "else": {
        "properties": {
          "usage": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "resultAvailability": {
            "const": "available"
          }
        }
      },
      "else": {
        "properties": {
          "resultAvailability": {
            "enum": [
              "none",
              "pending",
              "not_retained"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "settled"
          },
          "outcome": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "resultAvailability": {
            "const": "not_retained"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "pending"
          }
        }
      },
      "then": {
        "properties": {
          "resultAvailability": {
            "const": "pending"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "unknown",
              "rejected",
              "prepared"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "resultAvailability": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "accounting": {
            "properties": {
              "chargedChecks": {
                "const": 1
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "usage": {
            "properties": {
              "processingOutcome": {
                "const": "complete"
              }
            }
          }
        }
      }
    }
  ]
}
