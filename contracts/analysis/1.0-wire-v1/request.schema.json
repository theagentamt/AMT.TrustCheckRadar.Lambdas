{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legacy /analysis 1.0 post-trim input projection; see serialization notes",
  "type": "object",
  "required": [
    "schemaVersion",
    "requestId",
    "sourceType",
    "localSanitizationApplied",
    "sanitizedText",
    "entities"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sourceType": {
      "enum": [
        "pasted_text",
        "ocr",
        "mixed"
      ]
    },
    "localSanitizationApplied": {
      "const": true
    },
    "sanitizedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "entities": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "token",
          "type"
        ],
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "email",
              "phone",
              "url",
              "credit_card",
              "ssn",
              "ip_address",
              "messenger_handle",
              "payment_handle",
              "crypto_wallet"
            ]
          }
        }
      }
    },
    "campaignConsentGranted": {
      "type": "boolean"
    },
    "appFeatures": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "extractorVersion",
            "languageId",
            "taxonomyBucket",
            "vector",
            "lexicalFingerprint",
            "signalIds",
            "indicatorIds",
            "confidence"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "extractorVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "description": "Additional runtime limit:64 UTF-8 bytes."
            },
            "languageId": {
              "enum": [
                "en",
                "es",
                "multilingual",
                "other",
                "unknown"
              ]
            },
            "taxonomyBucket": {
              "enum": [
                "advance_fee",
                "credential_theft",
                "impersonation",
                "investment",
                "romance",
                "employment",
                "marketplace",
                "extortion",
                "tech_support",
                "other",
                "unknown"
              ]
            },
            "vector": {
              "type": "array",
              "minItems": 1,
              "maxItems": 384,
              "items": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            },
            "lexicalFingerprint": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{16}$"
              }
            },
            "signalIds": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
              }
            },
            "indicatorIds": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "campaignConsentGranted"
        ],
        "properties": {
          "campaignConsentGranted": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "appFeatures"
        ],
        "properties": {
          "appFeatures": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schemaVersion",
              "extractorVersion",
              "languageId",
              "taxonomyBucket",
              "vector",
              "lexicalFingerprint",
              "signalIds",
              "indicatorIds",
              "confidence"
            ],
            "properties": {
              "schemaVersion": {
                "const": 1
              },
              "extractorVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "Additional runtime limit:64 UTF-8 bytes."
              },
              "languageId": {
                "enum": [
                  "en",
                  "es",
                  "multilingual",
                  "other",
                  "unknown"
                ]
              },
              "taxonomyBucket": {
                "enum": [
                  "advance_fee",
                  "credential_theft",
                  "impersonation",
                  "investment",
                  "romance",
                  "employment",
                  "marketplace",
                  "extortion",
                  "tech_support",
                  "other",
                  "unknown"
                ]
              },
              "vector": {
                "type": "array",
                "minItems": 1,
                "maxItems": 384,
                "items": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                }
              },
              "lexicalFingerprint": {
                "type": "array",
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                }
              },
              "signalIds": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
                }
              },
              "indicatorIds": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
                }
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    }
  ]
}
