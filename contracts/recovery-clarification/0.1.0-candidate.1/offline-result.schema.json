{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "state",
    "reason",
    "suggestedExposureIds",
    "suggestedActionIds",
    "questionIds",
    "baselinePlan",
    "baselineDisposition",
    "authorityAccounting",
    "providerCalls"
  ],
  "properties": {
    "contractVersion": {
      "const": "recovery-clarification-0.1.0-candidate.1"
    },
    "state": {
      "enum": [
        "unavailable",
        "cancelled",
        "uncertain",
        "rejected",
        "offline_proposal"
      ]
    },
    "reason": {
      "enum": [
        "disabled",
        "cancelled",
        "input_invalid",
        "privacy_rejected",
        "hostile_input",
        "output_invalid",
        "simulator_failed",
        "baseline_unavailable",
        "needs_confirmation",
        "abstained",
        null
      ]
    },
    "suggestedExposureIds": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "clicked_link",
          "credentials_or_mfa",
          "financial_or_identity",
          "sent_payment",
          "software_or_remote_access"
        ]
      }
    },
    "suggestedActionIds": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "basics_link",
          "basics_password",
          "basics_identity",
          "basics_payment",
          "basics_device"
        ]
      }
    },
    "questionIds": {
      "const": []
    },
    "baselinePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "contentBundleVersion",
        "state",
        "reason",
        "actionIds",
        "officialLinkIds",
        "reviewDue",
        "clarification",
        "accounting"
      ],
      "properties": {
        "contractVersion": {
          "const": "recovery-selection-1.0.0"
        },
        "contentBundleVersion": {
          "const": "recovery-basics-1.0"
        },
        "state": {
          "enum": [
            "available",
            "review_due",
            "sign_in_required",
            "limited_help"
          ]
        },
        "reason": {
          "enum": [
            null,
            "sign_in_required",
            "selection_unapproved",
            "content_missing",
            "content_withdrawn",
            "content_incompatible",
            "content_unapproved"
          ]
        },
        "actionIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 5,
          "items": {
            "enum": [
              "basics_link",
              "basics_password",
              "basics_identity",
              "basics_payment",
              "basics_device"
            ]
          }
        },
        "officialLinkIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "recovery_guidance",
              "identity_help",
              "fraud_report"
            ]
          }
        },
        "reviewDue": {
          "type": "boolean"
        },
        "clarification": {
          "const": "unavailable"
        },
        "accounting": {
          "const": "not_an_analysis_check"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "available",
                  "review_due"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": null
              },
              "actionIds": {
                "minItems": 1
              },
              "officialLinkIds": {
                "const": [
                  "recovery_guidance",
                  "identity_help",
                  "fraud_report"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "actionIds": {
                "maxItems": 0
              },
              "officialLinkIds": {
                "maxItems": 0
              },
              "reviewDue": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "review_due"
              }
            }
          },
          "then": {
            "properties": {
              "reviewDue": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "reviewDue": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "sign_in_required"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": "sign_in_required"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "limited_help"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "selection_unapproved",
                  "content_missing",
                  "content_withdrawn",
                  "content_incompatible",
                  "content_unapproved"
                ]
              }
            }
          }
        }
      ]
    },
    "baselineDisposition": {
      "const": "unchanged"
    },
    "authorityAccounting": {
      "const": "not_exercised"
    },
    "providerCalls": {
      "const": 0
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "offline_proposal"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": null
          },
          "suggestedExposureIds": {
            "minItems": 1
          },
          "suggestedActionIds": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "suggestedExposureIds": {
            "maxItems": 0
          },
          "suggestedActionIds": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "uncertain"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "needs_confirmation",
              "abstained"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "cancelled"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "cancelled"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "disabled",
              "simulator_failed",
              "baseline_unavailable"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "rejected"
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "input_invalid",
              "privacy_rejected",
              "hostile_input",
              "output_invalid"
            ]
          }
        }
      }
    }
  ]
}
