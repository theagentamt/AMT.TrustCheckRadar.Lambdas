{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amt.example/contracts/device-recovery/1.0.0/self-recovery-success.schema.json",
  "title": "Device self-recovery V1 original-operation result",
  "description": "This response is immutable evidence of the original recovery outcome. It is not current device-binding status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operationId",
    "operation",
    "result",
    "status",
    "bindingFingerprint",
    "completedAtEpoch"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "operationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "operation": {"const": "REPLACE_ACTIVE_BINDING"},
    "result": {"const": "RECOVERED"},
    "status": {
      "const": "COMPLETE",
      "description": "Operation completion status, not current binding status."
    },
    "bindingFingerprint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$",
      "description": "Target of the original operation; it may no longer be active when this is an idempotent replay."
    },
    "completedAtEpoch": {"type": "integer", "minimum": 1}
  }
}
