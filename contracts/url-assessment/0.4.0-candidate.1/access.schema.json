{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "basis",
    "externalChecksAllowed",
    "builtInChecksAllowed",
    "reconciliationAllowed",
    "remainingChecks",
    "resetsAt",
    "unlimited",
    "observedAt"
  ],
  "properties": {
    "state": {
      "enum": [
        "allowed",
        "sign_in_required",
        "device_action_required",
        "subscription_required",
        "allowance_exhausted",
        "temporarily_unavailable"
      ]
    },
    "basis": {
      "enum": [
        "paid",
        "trial",
        "complimentary",
        "none",
        "unknown"
      ]
    },
    "externalChecksAllowed": {
      "type": "boolean"
    },
    "builtInChecksAllowed": {
      "type": "boolean"
    },
    "reconciliationAllowed": {
      "type": "boolean"
    },
    "remainingChecks": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "resetsAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "unlimited": {
      "type": "boolean"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "allowed"
          }
        }
      },
      "then": {
        "properties": {
          "externalChecksAllowed": {
            "const": true
          },
          "basis": {
            "enum": [
              "paid",
              "trial",
              "complimentary"
            ]
          },
          "builtInChecksAllowed": {
            "const": true
          },
          "reconciliationAllowed": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "not": {
              "const": "allowed"
            }
          }
        }
      },
      "then": {
        "properties": {
          "externalChecksAllowed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "sign_in_required"
          }
        }
      },
      "then": {
        "properties": {
          "builtInChecksAllowed": {
            "const": false
          },
          "reconciliationAllowed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "allowance_exhausted"
          }
        }
      },
      "then": {
        "properties": {
          "remainingChecks": {
            "const": 0
          },
          "unlimited": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "unlimited": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "basis": {
            "const": "complimentary"
          },
          "remainingChecks": {
            "type": "null"
          },
          "resetsAt": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "allowed"
          },
          "basis": {
            "enum": [
              "paid",
              "trial"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "remainingChecks": {
            "type": "integer",
            "minimum": 1
          },
          "unlimited": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "allowed"
          },
          "basis": {
            "const": "complimentary"
          }
        }
      },
      "then": {
        "properties": {
          "unlimited": {
            "const": true
          }
        }
      }
    }
  ]
}
