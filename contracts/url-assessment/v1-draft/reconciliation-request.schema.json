{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "operation",
    "checkId"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.2.0-candidate.1"
    },
    "operation": {
      "const": "reconcile"
    },
    "checkId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    }
  }
}
