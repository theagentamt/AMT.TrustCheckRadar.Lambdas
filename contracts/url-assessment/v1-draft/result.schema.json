{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "checkId",
    "assessedAt",
    "verdict",
    "processingOutcome",
    "uncertainty",
    "evidence",
    "reasonCodes",
    "transportWarnings",
    "nextAction",
    "messageKey"
  ],
  "properties": {
    "contractVersion": {
      "const": "0.1.0-draft.1"
    },
    "checkId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "assessedAt": {
      "type": "string",
      "format": "date-time"
    },
    "verdict": {
      "enum": [
        "no_known_threat_detected",
        "suspicious",
        "high_risk",
        "unknown"
      ]
    },
    "processingOutcome": {
      "enum": [
        "complete",
        "partial",
        "unavailable",
        "blocked",
        "invalid_input",
        "unsupported"
      ]
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage",
        "limitations"
      ],
      "properties": {
        "coverage": {
          "enum": [
            "supported_checks_complete",
            "limited",
            "not_assessed"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "maxItems": 16
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "outcome",
          "targetScope"
        ],
        "properties": {
          "source": {
            "enum": [
              "google_web_risk_lookup",
              "http_redirect_resolver",
              "local_validation",
              "amt_rule"
            ]
          },
          "outcome": {
            "enum": [
              "match",
              "no_match",
              "completed",
              "incomplete",
              "blocked",
              "unavailable",
              "suspicious_pattern"
            ]
          },
          "targetScope": {
            "enum": [
              "full_submitted_url",
              "origin_only",
              "redirect_hop",
              "none"
            ]
          }
        }
      },
      "maxItems": 12
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 16
    },
    "transportWarnings": {
      "type": "array",
      "items": {
        "enum": [
          "UNENCRYPTED_CONNECTION",
          "HTTPS_TO_HTTP_REDIRECT"
        ]
      },
      "maxItems": 2
    },
    "nextAction": {
      "enum": [
        "avoid_link",
        "verify_independently",
        "review_input",
        "use_built_in_help"
      ]
    },
    "messageKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "no_known_threat_detected"
          }
        }
      },
      "then": {
        "properties": {
          "processingOutcome": {
            "const": "complete"
          },
          "uncertainty": {
            "properties": {
              "coverage": {
                "const": "supported_checks_complete"
              }
            }
          },
          "evidence": {
            "contains": {
              "properties": {
                "source": {
                  "const": "google_web_risk_lookup"
                },
                "outcome": {
                  "const": "no_match"
                },
                "targetScope": {
                  "const": "full_submitted_url"
                }
              },
              "required": [
                "source",
                "outcome",
                "targetScope"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "processingOutcome": {
            "enum": [
              "unavailable",
              "blocked",
              "invalid_input",
              "unsupported"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "verdict": {
            "const": "unknown"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "suspicious"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "source": {
                  "const": "amt_rule"
                },
                "outcome": {
                  "const": "suspicious_pattern"
                }
              },
              "required": [
                "source",
                "outcome"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "high_risk"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "source": {
                  "const": "google_web_risk_lookup"
                },
                "outcome": {
                  "const": "match"
                }
              },
              "required": [
                "source",
                "outcome"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "source": {
                  "const": "google_web_risk_lookup"
                },
                "outcome": {
                  "const": "match"
                }
              },
              "required": [
                "source",
                "outcome"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "verdict": {
            "const": "high_risk"
          },
          "processingOutcome": {
            "enum": [
              "complete",
              "partial"
            ]
          },
          "nextAction": {
            "const": "avoid_link"
          }
        }
      }
    }
  ]
}
