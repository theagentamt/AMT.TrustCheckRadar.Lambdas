{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "purpose",
    "purposeVersion",
    "noticeVersion",
    "policyVersion",
    "state",
    "stateVersion",
    "ageBand",
    "stateCode",
    "validUntilEpoch",
    "updatedAtEpoch",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "purpose": {
      "const": "optional-demographic-protection-research"
    },
    "purposeVersion": {
      "const": "consumer-protection-research-v1"
    },
    "noticeVersion": {
      "const": "demographic-research-2026-09-30-v1"
    },
    "policyVersion": {
      "const": "optional-demographic-research-v1"
    },
    "state": {
      "enum": [
        "not_enrolled",
        "enrolled",
        "review_required",
        "withdrawn"
      ]
    },
    "stateVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ageBand": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "18_24",
            "25_34",
            "35_44",
            "45_54",
            "55_64",
            "65_74",
            "75_PLUS",
            "PREFER_NOT_TO_SAY"
          ]
        }
      ]
    },
    "stateCode": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "AL",
            "AK",
            "AZ",
            "AR",
            "CA",
            "CO",
            "CT",
            "DE",
            "FL",
            "GA",
            "HI",
            "ID",
            "IL",
            "IN",
            "IA",
            "KS",
            "KY",
            "LA",
            "ME",
            "MD",
            "MA",
            "MI",
            "MN",
            "MS",
            "MO",
            "MT",
            "NE",
            "NV",
            "NH",
            "NJ",
            "NM",
            "NY",
            "NC",
            "ND",
            "OH",
            "OK",
            "OR",
            "PA",
            "RI",
            "SC",
            "SD",
            "TN",
            "TX",
            "UT",
            "VT",
            "VA",
            "WA",
            "WV",
            "WI",
            "WY",
            "DC",
            "OTHER_US_JURISDICTION",
            "PREFER_NOT_TO_SAY"
          ]
        }
      ]
    },
    "validUntilEpoch": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "updatedAtEpoch": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enrollmentEnabled",
        "updateEnabled",
        "withdrawalEnabled"
      ],
      "properties": {
        "enrollmentEnabled": {
          "type": "boolean"
        },
        "updateEnabled": {
          "type": "boolean"
        },
        "withdrawalEnabled": {
          "type": "boolean"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "status",
        "action",
        "resultingState",
        "stateVersion"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "status": {
          "enum": [
            "applied",
            "not_found"
          ]
        },
        "action": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "enroll",
                "update",
                "withdraw"
              ]
            }
          ]
        },
        "resultingState": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "enrolled",
                "withdrawn"
              ]
            }
          ]
        },
        "stateVersion": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "enrolled"
          }
        }
      },
      "then": {
        "properties": {
          "ageBand": {
            "enum": [
              "18_24",
              "25_34",
              "35_44",
              "45_54",
              "55_64",
              "65_74",
              "75_PLUS",
              "PREFER_NOT_TO_SAY"
            ]
          },
          "stateCode": {
            "enum": [
              "AL",
              "AK",
              "AZ",
              "AR",
              "CA",
              "CO",
              "CT",
              "DE",
              "FL",
              "GA",
              "HI",
              "ID",
              "IL",
              "IN",
              "IA",
              "KS",
              "KY",
              "LA",
              "ME",
              "MD",
              "MA",
              "MI",
              "MN",
              "MS",
              "MO",
              "MT",
              "NE",
              "NV",
              "NH",
              "NJ",
              "NM",
              "NY",
              "NC",
              "ND",
              "OH",
              "OK",
              "OR",
              "PA",
              "RI",
              "SC",
              "SD",
              "TN",
              "TX",
              "UT",
              "VT",
              "VA",
              "WA",
              "WV",
              "WI",
              "WY",
              "DC",
              "OTHER_US_JURISDICTION",
              "PREFER_NOT_TO_SAY"
            ]
          },
          "validUntilEpoch": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "else": {
        "properties": {
          "ageBand": {
            "type": "null"
          },
          "stateCode": {
            "type": "null"
          },
          "validUntilEpoch": {
            "type": "null"
          }
        }
      }
    }
  ]
}
