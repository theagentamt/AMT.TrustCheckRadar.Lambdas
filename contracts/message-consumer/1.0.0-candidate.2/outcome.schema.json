          "AI_CONSEQUENTIAL_URGENCY",
          "AI_CREDENTIAL_REQUEST",
          "AI_PAYMENT_PRESSURE",
          "AI_PRETEXT",
          "AI_VERIFICATION_BYPASS"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
