                        "const": "warning"
                      }
                    }
                  }
                },
                {
                  "properties": {
                    "limitationCodes": {
                      "minItems": 1
                    }
                  }
                }
              ]
            },
            {
              "not": {
                "properties": {
                  "limitationCodes": {
                    "contains": {
                      "const": "HOSTILE_INPUT_STOP"
                    }
                  }
                }
              }
            },
            {
              "not": {
                "properties": {
                  "limitationCodes": {
                    "contains": {
                      "enum": [
                        "PROVIDER_UNAVAILABLE",
                        "PROVIDER_RESPONSE_INVALID",
                        "BUDGET_LIMIT"
                      ]
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "properties": {
            "verdict": {
              "const": "unknown"
            },
            "processingOutcome": {
              "const": "inconclusive"
            },
            "messageKey": {
              "const": "message.ai_inconclusive"
            },
            "nextAction": {
              "const": "review_input"
            }
          }
        }
      ]
    }
  ]
}
