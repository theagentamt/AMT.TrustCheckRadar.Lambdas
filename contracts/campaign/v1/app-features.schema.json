{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.andmorethings.com/trustcheck-radar/campaign/1.0.0/app-features.schema.json",
  "title": "App-generated campaign features V1",
  "$comment": "Canonical compact UTF-8 JSON must be no more than 32768 bytes. JSON numbers must be finite.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "extractorVersion",
    "languageId",
    "taxonomyBucket",
    "vector",
    "lexicalFingerprint",
    "signalIds",
    "indicatorIds",
    "confidence"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "extractorVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "languageId": {"enum": ["en", "es", "multilingual", "other", "unknown"]},
    "taxonomyBucket": {"enum": ["advance_fee", "credential_theft", "impersonation", "investment", "romance", "employment", "marketplace", "extortion", "tech_support", "other", "unknown"]},
    "vector": {
      "type": "array",
      "minItems": 1,
      "maxItems": 384,
      "items": {"type": "number", "minimum": -1, "maximum": 1}
    },
    "lexicalFingerprint": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
    },
    "signalIds": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}
    },
    "indicatorIds": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
