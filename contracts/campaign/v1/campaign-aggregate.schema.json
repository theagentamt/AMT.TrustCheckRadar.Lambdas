{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.andmorethings.com/trustcheck-radar/campaign/1.0.0/campaign-aggregate.schema.json",
  "title": "Thresholded campaign aggregate V1",
  "$comment": "Only anonymous group data at or above ten contributors may satisfy this contract. Exact internal counts are never app-facing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["PK", "SK", "campaignId", "schemaVersion", "taxonomyVersion", "categoryId", "periodWeek", "state", "contributorCount", "submissionCount", "contributorCountBand", "submissionCountBand", "dimensionSchemaVersion", "languageIds", "tacticIds", "channelIds", "riskBand", "summaryKey", "trendDirection", "expiresAt", "version", "environment"],
  "properties": {
    "PK": {"type": "string", "pattern": "^CAMPAIGN#[A-Za-z0-9_-]{1,64}$"},
    "SK": {"const": "AGGREGATE"},
    "campaignId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "schemaVersion": {"const": 1},
    "taxonomyVersion": {"const": 1},
    "categoryId": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "periodWeek": {"type": "string", "pattern": "^\\d{4}-W(?:0[1-9]|[1-4]\\d|5[0-3])$"},
    "state": {"enum": ["PENDING_REVIEW", "CONFIRMED", "PUBLISHED", "SUPPRESSED"]},
    "contributorCount": {"type": "integer", "minimum": 10},
    "submissionCount": {"type": "integer", "minimum": 10},
    "contributorCountBand": {"enum": ["10-24", "25-49", "50-99", "100-249", "250+"]},
    "submissionCountBand": {"enum": ["10-24", "25-49", "50-99", "100-249", "250+"]},
    "dimensionSchemaVersion": {"const": 1},
    "languageIds": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}},
    "tacticIds": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}},
    "channelIds": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}},
    "riskBand": {"enum": ["low", "medium", "high", "unknown"]},
    "summaryKey": {"type": "string", "pattern": "^campaign\\.[a-z][a-z0-9_]{0,63}$"},
    "trendDirection": {"enum": ["new", "rising", "stable", "falling"]},
    "expiresAt": {"type": "integer", "minimum": 0},
    "version": {"type": "integer", "minimum": 1},
    "environment": {"enum": ["dev", "uat", "prod"]},
    "GSI1PK": {"const": "STATE#PUBLISHED"},
    "GSI1SK": {"type": "string", "minLength": 1, "maxLength": 160}
  }
}
