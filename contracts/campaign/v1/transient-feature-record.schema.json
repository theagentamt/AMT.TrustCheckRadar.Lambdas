{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.andmorethings.com/trustcheck-radar/campaign/1.0.0/transient-feature-record.schema.json",
  "title": "Transient campaign feature record V1",
  "$comment": "This encrypted record expires within 21 days and must never be copied into a persistent aggregate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["PK", "SK", "schemaVersion", "recordVersion", "environment", "statisticsEventId", "periodId", "contributorToken", "GSI1PK", "GSI1SK", "extractorVersion", "languageId", "taxonomyBucket", "vector", "lexicalFingerprint", "signalIds", "indicatorIds", "confidence", "expiresAt"],
  "properties": {
    "PK": {"type": "string", "pattern": "^EVENT#[0-9a-f-]{36}$"},
    "SK": {"const": "FEATURE"},
    "schemaVersion": {"const": 1},
    "recordVersion": {"const": 1},
    "environment": {"enum": ["dev", "uat", "prod"]},
    "statisticsEventId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "periodId": {"type": "integer", "minimum": 0},
    "contributorToken": {"type": "string", "minLength": 32, "maxLength": 128},
    "GSI1PK": {"type": "string", "minLength": 1, "maxLength": 256},
    "GSI1SK": {"type": "string", "minLength": 1, "maxLength": 256},
    "extractorVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "languageId": {"enum": ["en", "es", "multilingual", "other", "unknown"]},
    "taxonomyBucket": {"enum": ["advance_fee", "credential_theft", "impersonation", "investment", "romance", "employment", "marketplace", "extortion", "tech_support", "other", "unknown"]},
    "vector": {"type": "array", "minItems": 1, "maxItems": 384, "items": {"type": "number", "minimum": -1, "maximum": 1}},
    "lexicalFingerprint": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{16}$"}},
    "signalIds": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}},
    "indicatorIds": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "expiresAt": {"type": "integer", "minimum": 0},
    "suppressed": {"type": "boolean"}
  }
}
