{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.andmorethings.com/trustcheck-radar/campaign/1.0.0/outbox-record.schema.json",
  "title": "Campaign observation outbox record V1",
  "$comment": "accountId and sanitizedText are permitted only in the encrypted outbox for at most 72 hours. expiresAt must be no later than observedAtEpoch plus 259200 seconds.",
  "type": "object",
  "additionalProperties": false,
  "required": ["PK", "SK", "schemaVersion", "recordVersion", "eventType", "environment", "statisticsEventId", "accountId", "campaignConsentGranted", "consentEpochId", "noticeVersion", "observedAtEpoch", "sourceType", "sanitizedText", "riskLevel", "signalIds", "appFeatures", "expiresAt"],
  "properties": {
    "PK": {"type": "string", "pattern": "^EVENT#[0-9a-f-]{36}$"},
    "SK": {"const": "OBSERVATION_READY"},
    "schemaVersion": {"const": 1},
    "recordVersion": {"const": 1},
    "eventType": {"const": "campaign.observation.ready"},
    "environment": {"enum": ["dev", "uat", "prod"]},
    "statisticsEventId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "accountId": {"type": "string", "minLength": 1, "maxLength": 256},
    "campaignConsentGranted": {"const": true},
    "consentEpochId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "noticeVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "observedAtEpoch": {"type": "integer", "minimum": 0},
    "sourceType": {"enum": ["ocr", "pasted_text", "mixed"]},
    "sanitizedText": {"type": "string", "minLength": 1, "maxLength": 12000},
    "riskLevel": {"enum": ["low", "medium", "high", "unknown"]},
    "signalIds": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"}},
    "appFeatures": {"$ref": "app-features.schema.json"},
    "expiresAt": {"type": "integer", "minimum": 0}
  }
}
