{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andmorethings.com/contracts/age-attestation/1.0.0-candidate.1/request.schema.json",
  "title": "Age attestation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operationId", "over18Acknowledged", "agePolicyVersion"],
  "properties": {
    "schemaVersion": {"const": 1},
    "operationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "over18Acknowledged": {"const": true},
    "agePolicyVersion": {"const": "v1.0"}
  }
}
