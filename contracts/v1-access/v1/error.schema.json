{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amt:v1-access:error:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "error"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "retryable"
      ],
      "properties": {
        "code": {
          "enum": [
            "INPUT_REJECTED",
            "AUTHENTICATION_REQUIRED",
            "ACCOUNT_UNAVAILABLE",
            "ACTIVE_DEVICE_REQUIRED",
            "TRIAL_NOT_ELIGIBLE",
            "AUTHORITY_SNAPSHOT_CHANGED",
            "TRANSACTION_UNCERTAIN",
            "ACCESS_SERVICE_UNAVAILABLE"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}
