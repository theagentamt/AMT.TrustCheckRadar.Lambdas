{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "intent",
    "purchaseToken"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "intent": {
      "enum": [
        "PURCHASE",
        "RESTORE"
      ]
    },
    "purchaseToken": {
      "type": "string",
      "minLength": 10,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9\\-._~+/=]+$"
    }
  }
}
