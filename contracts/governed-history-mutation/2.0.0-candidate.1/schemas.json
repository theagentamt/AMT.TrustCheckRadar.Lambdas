{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POLICY-BLOCKED technical draft; not active API",
  "state": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "incarnation",
      "generation"
    ],
    "properties": {
      "incarnation": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$",
        "not": {
          "pattern": "[\\r\\n]"
        }
      },
      "generation": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    }
  },
  "mutationRequest": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "family",
      "operationId",
      "expectedHistoryState",
      "intentLease"
    ],
    "properties": {
      "schemaVersion": {
        "const": 2
      },
      "family": {
        "const": "governed-history"
      },
      "operationId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "not": {
          "pattern": "[\\r\\n]"
        }
      },
      "expectedHistoryState": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "incarnation",
          "generation"
        ],
        "properties": {
          "incarnation": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          },
          "generation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "intentLease": {
        "type": "string",
        "minLength": 32,
        "maxLength": 4096,
        "pattern": "^[A-Za-z0-9_-]+[.][A-Za-z0-9_-]+$",
        "not": {
          "pattern": "[\\r\\n]"
        }
      }
    }
  },
  "bootstrapInspect": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "family",
      "mode"
    ],
    "properties": {
      "schemaVersion": {
        "const": 2
      },
      "family": {
        "const": "governed-history"
      },
      "mode": {
        "const": "inspect"
      },
      "operationId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "not": {
          "pattern": "[\\r\\n]"
        }
      }
    }
  },
  "bootstrapStartFresh": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "family",
      "mode",
      "operationId",
      "expectedHistoryState",
      "intentLease"
    ],
    "properties": {
      "schemaVersion": {
        "const": 2
      },
      "family": {
        "const": "governed-history"
      },
      "mode": {
        "const": "start_fresh"
      },
      "operationId": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "not": {
          "pattern": "[\\r\\n]"
        }
      },
      "expectedHistoryState": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "incarnation",
              "generation"
            ],
            "properties": {
              "incarnation": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$",
                "not": {
                  "pattern": "[\\r\\n]"
                }
              },
              "generation": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "intentLease": {
        "type": "string",
        "minLength": 32,
        "maxLength": 4096,
        "pattern": "^[A-Za-z0-9_-]+[.][A-Za-z0-9_-]+$",
        "not": {
          "pattern": "[\\r\\n]"
        }
      }
    }
  },
  "bootstrapPrepare": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "family",
      "mode",
      "action",
      "expectedHistoryState"
    ],
    "properties": {
      "schemaVersion": {
        "const": 2
      },
      "family": {
        "const": "governed-history"
      },
      "mode": {
        "const": "prepare"
      },
      "action": {
        "enum": [
          "delete_one",
          "clear",
          "start_fresh"
        ]
      },
      "expectedHistoryState": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "incarnation",
              "generation"
            ],
            "properties": {
              "incarnation": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$",
                "not": {
                  "pattern": "[\\r\\n]"
                }
              },
              "generation": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "targetResultId": {
        "type": "string",
        "pattern": "^gh1_[0-9]{1,12}_[0-9a-f]{32}$",
        "not": {
          "pattern": "[\\r\\n]"
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "action": {
              "const": "delete_one"
            }
          }
        },
        "then": {
          "required": [
            "targetResultId"
          ]
        },
        "else": {
          "not": {
            "required": [
              "targetResultId"
            ]
          }
        }
      },
      {
        "if": {
          "properties": {
            "action": {
              "enum": [
                "delete_one",
                "clear"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "expectedHistoryState": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "incarnation",
                "generation"
              ],
              "properties": {
                "incarnation": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$",
                  "not": {
                    "pattern": "[\\r\\n]"
                  }
                },
                "generation": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          }
        }
      }
    ]
  }
}
