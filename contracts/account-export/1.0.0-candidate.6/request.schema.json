{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "action"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "action": {
          "const": "START_EXPORT"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "action",
        "cursor"
      ],
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "action": {
          "const": "CONTINUE_EXPORT"
        },
        "cursor": {
          "type": "string",
          "minLength": 40,
          "maxLength": 8192
        }
      }
    }
  ]
}
