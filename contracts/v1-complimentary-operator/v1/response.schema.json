{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amt:v1-complimentary-operator:response:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "access"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "state", "basis"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["ACTIVE", "INACTIVE"] },
        "basis": { "type": ["string", "null"], "enum": ["complimentary", "paid", "trial", null] }
      }
    }
  }
}
