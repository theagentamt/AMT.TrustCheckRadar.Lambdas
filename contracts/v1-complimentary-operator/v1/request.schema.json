{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:amt:v1-complimentary-operator:request:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operationId",
    "accountId",
    "action",
    "reasonCode",
    "expiresAtEpoch"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,199}$"
    },
    "action": { "enum": ["grant", "revoke"] },
    "reasonCode": {
      "enum": ["OWNER_GRANT", "SUPPORT_GRANT", "REVOKE", "CORRECTION"]
    },
    "expiresAtEpoch": {
      "type": ["integer", "null"],
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "revoke" } }, "required": ["action"] },
      "then": {
        "properties": {
          "reasonCode": { "enum": ["REVOKE", "CORRECTION"] },
          "expiresAtEpoch": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "reasonCode": { "enum": ["OWNER_GRANT", "SUPPORT_GRANT", "CORRECTION"] }
        }
      }
    }
  ]
}
